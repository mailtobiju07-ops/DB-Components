Description:
This script analyzes database segment space usage using DBA_SEGMENTS and identifies the top space-consuming objects across the database.
It ranks segments (tables, indexes, LOBs, etc.) by size and calculates their percentage contribution to total storage, helping DBAs quickly identify storage-heavy objects.
-- ============================================================
-- Script Name  : top_storage_objects_dba.sql
-- Description  : Identify top space-consuming objects (DBA view)
-- ============================================================

WITH segment_summary AS (
    SELECT  
        segment_type,
        owner,
        segment_name,
        tablespace_name,
        COUNT(*) AS segment_count,
        SUM(extents) AS total_extents,
        SUM(blocks) AS total_blocks,
        SUM(bytes) AS total_bytes
    FROM dba_segments
    GROUP BY
        segment_type,
        owner,
        segment_name,
        tablespace_name
),

database_totals AS (
    SELECT  
        SUM(segment_count) AS segments,
        SUM(total_extents) AS extents,
        SUM(total_blocks) AS blocks,
        SUM(total_bytes) AS bytes
    FROM segment_summary
),

ranked_segments AS (
    SELECT 
        s.*,
        ROUND((s.total_bytes / t.bytes) * 100, 3) AS bytes_pct,
        ROW_NUMBER() OVER (ORDER BY s.total_bytes DESC) AS rank_no
    FROM segment_summary s
    CROSS JOIN database_totals t
),

top_segments AS (
    SELECT *
    FROM ranked_segments
    WHERE rank_no <= 200
),

-- Object mapping (JOIN instead of scalar subqueries)
object_map AS (
    SELECT 
        owner,
        object_name,
        object_type,
        object_id,
        data_object_id
    FROM dba_objects
    WHERE object_type NOT LIKE '%PARTITION%'
),

index_map AS (
    SELECT owner, index_name, table_name
    FROM dba_indexes
),

lob_map AS (
    SELECT owner, segment_name, table_name
    FROM dba_lobs
),

final_data AS (
    SELECT 
        t.rank_no,
        t.segment_type,
        t.owner,
        t.segment_name,
        t.tablespace_name,

        COALESCE(i.table_name, l.table_name) AS table_name,

        t.total_bytes,
        ROUND(t.total_bytes/1024/1024,2) AS size_mb,
        ROUND(t.total_bytes/1024/1024/1024,3) AS size_gb,

        t.bytes_pct,

        -- ⚡ Analytic cumulative %
        ROUND(SUM(t.bytes_pct) OVER (ORDER BY t.rank_no), 3) AS cumulative_pct

    FROM top_segments t
    LEFT JOIN object_map o
        ON o.owner = t.owner
       AND o.object_name = t.segment_name
       AND o.object_type = t.segment_type

    LEFT JOIN index_map i
        ON i.owner = t.owner
       AND i.index_name = t.segment_name

    LEFT JOIN lob_map l
        ON l.owner = t.owner
       AND l.segment_name = t.segment_name
),

top_20_summary AS (
    SELECT 
        SUM(total_bytes) AS bytes,
        SUM(bytes_pct) AS pct
    FROM final_data
    WHERE rank_no <= 20
),

top_100_summary AS (
    SELECT 
        SUM(total_bytes) AS bytes,
        SUM(bytes_pct) AS pct
    FROM final_data
    WHERE rank_no <= 100
),

top_200_summary AS (
    SELECT 
        SUM(total_bytes) AS bytes,
        SUM(bytes_pct) AS pct
    FROM final_data
)

SELECT * FROM (
    SELECT 
        rank_no,
        segment_type,
        owner,
        segment_name,
        tablespace_name,
        table_name,
        total_bytes,
        size_mb,
        size_gb,
        bytes_pct,
        cumulative_pct
    FROM final_data

    UNION ALL

    SELECT 
        NULL,NULL,NULL,NULL,'TOP 20',
        NULL,
        bytes,
        ROUND(bytes/1024/1024,2),
        ROUND(bytes/1024/1024/1024,3),
        pct,
        NULL
    FROM top_20_summary

    UNION ALL

    SELECT 
        NULL,NULL,NULL,NULL,'TOP 100',
        NULL,
        bytes,
        ROUND(bytes/1024/1024,2),
        ROUND(bytes/1024/1024/1024,3),
        pct,
        NULL
    FROM top_100_summary

    UNION ALL

    SELECT 
        NULL,NULL,NULL,NULL,'TOP 200',
        NULL,
        bytes,
        ROUND(bytes/1024/1024,2),
        ROUND(bytes/1024/1024/1024,3),
        pct,
        NULL
    FROM top_200_summary
)
ORDER BY rank_no NULLS LAST;

