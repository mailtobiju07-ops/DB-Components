This script analyzes historical SQL performance from AWR (DBA_HIST_SQLSTAT) and presents per-execution metrics, plan changes, and performance signals.

-- ============================================================
-- Script Name  : awr_sql_perf_dba.sql
-- Purpose      : Deep AWR SQL performance analysis (DBA view)
-- Author       : Your Name
-- ============================================================

DEFINE sql_id     = '&1'
DEFINE start_time = '&2'
DEFINE end_time   = '&3'

COL inst        FORMAT 99        HEAD 'Inst'
COL snap_id     FORMAT 999999    HEAD 'Snap'
COL btime       FORMAT A16       HEAD 'Begin Time'
COL phash       FORMAT 9999999999 HEAD 'PlanHash'

COL exec        FORMAT 999999999 HEAD 'Execs'
COL ela_total   FORMAT 9999999999 HEAD 'TotEla(ms)'

COL cpx         FORMAT 99999999.999 HEAD 'CPUms/Exec'
COL elpx        FORMAT 99999999.999 HEAD 'ElaMs/Exec'

COL cpct        FORMAT 999 HEAD 'CPU%' TRUNC
COL ipct        FORMAT 999 HEAD 'IO%'  TRUNC

COL bgpx        FORMAT 999999999 HEAD 'Gets/Exec'
COL drpx        FORMAT 9999999   HEAD 'Reads/Exec'
COL rwpx        FORMAT 999999    HEAD 'Rows/Exec'

COL iowpx       FORMAT 99999999.999 HEAD 'IOms/Exec'
COL apwpx       FORMAT 99999.999    HEAD 'Appms/Exec'
COL conw        FORMAT 99999.999    HEAD 'Concms/Exec'

COL loads       FORMAT 999999 HEAD 'Loads'
COL inval       FORMAT 999999 HEAD 'Invalid'

COL remark      FORMAT A25 HEAD 'Observation'

SELECT
    ss.instance_number AS inst,
    ss.snap_id,
    TO_CHAR(sn.begin_interval_time,'DD-MON HH24:MI') AS btime,
    ss.plan_hash_value AS phash,

    SUM(GREATEST(ss.executions_delta,1)) AS exec,

    ROUND(SUM(ss.elapsed_time_delta)/1000,0) AS ela_total,

    ROUND(SUM(ss.cpu_time_delta)
        / SUM(GREATEST(ss.executions_delta,1)) / 1000,3) AS cpx,

    ROUND(SUM(ss.elapsed_time_delta)
        / SUM(GREATEST(ss.executions_delta,1)) / 1000,3) AS elpx,

    ROUND((SUM(ss.cpu_time_delta) 
        / NULLIF(SUM(ss.elapsed_time_delta),0))*100,1) AS cpct,

    ROUND((SUM(ss.iowait_delta) 
        / NULLIF(SUM(ss.elapsed_time_delta),0))*100,1) AS ipct,

    ROUND(SUM(ss.buffer_gets_delta)
        / SUM(GREATEST(ss.executions_delta,1)),0) AS bgpx,

    ROUND(SUM(ss.disk_reads_delta)
        / SUM(GREATEST(ss.executions_delta,1)),0) AS drpx,

    ROUND(SUM(ss.rows_processed_delta)
        / SUM(GREATEST(ss.executions_delta,1)),0) AS rwpx,

    ROUND(SUM(ss.iowait_delta)
        / SUM(GREATEST(ss.executions_delta,1)) / 1000,3) AS iowpx,

    ROUND(SUM(ss.apwait_delta)
        / SUM(GREATEST(ss.executions_delta,1)) / 1000,3) AS apwpx,

    ROUND(SUM(ss.ccwait_delta)
        / SUM(GREATEST(ss.executions_delta,1)) / 1000,3) AS conw,

    SUM(ss.loads_delta) AS loads,
    SUM(ss.invalidations_delta) AS inval,

    -- 🔍 DBA Observation Column
    CASE
        WHEN SUM(ss.elapsed_time_delta) = 0 THEN 'No Activity'
        WHEN (SUM(ss.cpu_time_delta)/SUM(ss.elapsed_time_delta))*100 > 80 
             THEN 'CPU Bound'
        WHEN (SUM(ss.iowait_delta)/SUM(ss.elapsed_time_delta))*100 > 40 
             THEN 'I/O Bound'
        WHEN SUM(ss.buffer_gets_delta)/SUM(GREATEST(ss.executions_delta,1)) > 100000
             THEN 'High Logical Reads'
        WHEN SUM(ss.disk_reads_delta)/SUM(GREATEST(ss.executions_delta,1)) > 1000
             THEN 'High Physical Reads'
        WHEN SUM(ss.invalidations_delta) > 0
             THEN 'Plan Invalidations'
        ELSE 'Normal'
    END AS remark

FROM dba_hist_sqlstat ss
JOIN dba_hist_snapshot sn
  ON sn.snap_id = ss.snap_id
 AND sn.dbid    = ss.dbid
 AND sn.instance_number = ss.instance_number

WHERE ss.sql_id = '&sql_id'
  AND sn.begin_interval_time BETWEEN 
      TO_DATE('&start_time','DD-MON-YYYY HH24:MI')
  AND TO_DATE('&end_time','DD-MON-YYYY HH24:MI')

GROUP BY
    ss.instance_number,
    ss.snap_id,
    sn.begin_interval_time,
    ss.plan_hash_value

ORDER BY ss.snap_id;
